# App
APP_NAME=AI Meeting Translator
DEBUG=True

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ai_meeting_translator

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Translation
# Providers: deep_google (miễn phí) | google (cần API key) | nllb (offline) | marian (offline)
TRANSLATION_PROVIDER=deep_google
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# TTS
# TTS_PROVIDER: gtts (miễn phí, cần internet) | edge (Microsoft, chất lượng cao)
TTS_PROVIDER=gtts
TTS_ENABLED=True
TTS_TIMEOUT=15

# Edge TTS: ghi đè voice mặc định (chỉ dùng khi TTS_PROVIDER=edge)
# Xem danh sách voice: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_EN=en-US-JennyNeural
EDGE_TTS_VOICE_KO=ko-KR-SunHiNeural
EDGE_TTS_VOICE_JA=ja-JP-NanamiNeural
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_FR=fr-FR-DeniseNeural
EDGE_TTS_VOICE_DE=de-DE-KatjaNeural
EDGE_TTS_VOICE_ES=es-ES-ElviraNeural

# Whisper
# Model benchmark trên CPU (i7, int8):
#   tiny  : ~0.5-1s/utterance, WER cao hơn, đủ cho demo
#   base  : ~1-2s/utterance, cân bằng tốt nhất cho real-time CPU
#   small : ~3-7s/utterance, chính xác hơn nhưng quá chậm cho real-time CPU
#   medium: >10s/utterance trên CPU — cần GPU
# Khuyến nghị: base cho CPU real-time, small nếu có GPU
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# beam_size=2: real-time CPU; tăng lên 4-5 nếu có GPU
WHISPER_BEAM_SIZE=2
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_PROB_MAX=0.6
WHISPER_AVG_LOGPROB_MIN=-1.0
WHISPER_COMPRESSION_RATIO_MAX=2.4

# VAD
VAD_THRESHOLD=0.3
VAD_MIN_SPEECH_MS=500
VAD_MIN_SILENCE_MS=800
VAD_SPEECH_PAD_MS=200
